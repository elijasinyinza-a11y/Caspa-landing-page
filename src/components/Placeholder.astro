---
/**
 * A labelled placeholder for content that is not yet confirmed.
 * Content rule: framework descriptions and unconfirmed facts stay as
 * placeholders until Elijah approves the wording.
 */
interface Props {
  text: string;
  tone?: 'light' | 'dark';
  as?: 'p' | 'div';
}
const { text, tone = 'light', as: Tag = 'p' } = Astro.props;
---
<Tag class:list={['placeholder', `placeholder--${tone}`]} data-placeholder>{text}</Tag>

<style>
  .placeholder {
    margin: 0.875rem 0 0;
    padding: 0.75rem 0.875rem;
    border: 1px dashed;
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
  }
  .placeholder--light { border-color: var(--muted); color: var(--muted); }
  .placeholder--dark { border-color: var(--on-navy-rule); color: var(--on-navy-muted); }
</style>
