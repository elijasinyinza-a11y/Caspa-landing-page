---
import { frontmatter as home } from '../../content/home.md';
import { site } from '../../data/site';
const { hero } = home;
---
<section class="hero" aria-labelledby="hero-h">
  <div class="container">
    <div class="hero__text">
      <h1 id="hero-h">{hero.headline}</h1>
      <p class="hero__sub">{hero.subhead}</p>
      <div class="hero__actions">
        <a href={site.primaryAction.href} class="btn btn--primary btn--lg">{site.primaryAction.label}</a>
        <a href="/how-it-works" class="btn btn--secondary btn--lg">See how it works</a>
      </div>
      <p class="hero__note">{hero.pilotNote}</p>
    </div>
  </div>
</section>

<style>
  /* Centred and compact: one narrow column so the eye reads it as a single block. */
  .hero { padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3rem, 6vw, 5rem); text-align: center; }
  .hero__text { max-width: 42rem; margin-inline: auto; }
  .hero h1 { text-wrap: balance; letter-spacing: -0.03em; }
  .hero__sub {
    margin: 1.25rem auto 0; max-width: 34em;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem); line-height: 1.5; color: var(--ink-soft);
    text-wrap: balance;
  }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1.75rem; }
  .hero__note { margin-top: 0.875rem; font-size: var(--text-caption); color: var(--muted); }
</style>
