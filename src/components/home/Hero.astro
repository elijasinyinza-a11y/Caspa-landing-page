---
import { frontmatter as home } from '../../content/home.md';
import { site } from '../../data/site';
const { hero } = home;
---
<section class="hero" aria-labelledby="hero-h">
  <div class="container">
    <div class="hero__text">
      <h1 id="hero-h">{hero.headline}</h1>
      <p class="hero__sub">{hero.subhead}</p>
      <div class="hero__actions">
        <a href={site.primaryAction.href} class="btn btn--primary btn--lg">{site.primaryAction.label}</a>
        <a href="/how-it-works" class="btn btn--secondary btn--lg">See how it works</a>
      </div>
      <p class="hero__note">{hero.pilotNote}</p>
    </div>
  </div>
</section>

<style>
  /* Centred: one message and one action, framed like the closing pilot section. */
  .hero { padding-block: clamp(3rem, 7vw, 6.5rem) clamp(3.5rem, 8vw, 7rem); text-align: center; }
  .hero__text { max-width: 56rem; margin-inline: auto; }
  .hero h1 { text-wrap: balance; }
  .hero__sub {
    margin: 1.5rem auto 0; max-width: 38em;
    font-size: clamp(1.125rem, 1.7vw, 1.3125rem); line-height: 1.5; color: var(--ink-soft);
    text-wrap: balance;
  }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 2.25rem; }
  .hero__note { margin-top: 1.25rem; font-size: var(--text-small); color: var(--muted); }
</style>
