---
import { frontmatter as home } from '../../content/home.md';
import FindingsDrawer from '../screens/FindingsDrawer.astro';
const { integrity } = home;
---
<section class="section section--white" aria-labelledby="integrity-h">
  <div class="container integrity">
    <div class="integrity__text">
      <h2 id="integrity-h">{integrity.heading}</h2>
      {integrity.paragraphs.map((p: string) => <p class="integrity__p">{p}</p>)}
      <p class="integrity__note">{integrity.note}</p>
      <a href="/integrity-checker" class="text-link">More about the integrity checker</a>
    </div>
    <div class="integrity__visual">
      <FindingsDrawer caption={integrity.caption} />
    </div>
  </div>
</section>

<style>
  .integrity { display: flex; flex-wrap: wrap; gap: clamp(2rem, 5vw, 4.5rem); align-items: flex-start; }
  .integrity__text { flex: 1 1 22.5rem; min-width: 0; max-width: 32.5rem; }
  .integrity__visual { flex: 1 1 26.25rem; min-width: 0; }
  .integrity__p { margin-top: 1rem; color: var(--ink-soft); }
  .integrity__note { margin-top: 0.875rem; font-size: var(--text-small); color: var(--muted); }
  .text-link { margin-top: 0.5rem; }
</style>
