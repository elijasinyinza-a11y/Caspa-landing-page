---
import { frontmatter as home } from '../../content/home.md';
import { site } from '../../data/site';
import Copy from '../Copy.astro';
import BookCover from '../BookCover.astro';
const { method } = home;
---
<section class="section section--navy" aria-labelledby="method-h">
  <div class="container method">
    <div class="method__cover"><BookCover /></div>
    <div class="method__text">
      <h2 id="method-h">{method.heading}</h2>
      <p class="lead">{method.intro}</p>
      <Copy text={method.framework} tone="dark" />
      <Copy text={method.author} tone="dark" />
      <div class="method__links">
        <a href={site.bookUrl} class="text-link">Read the book</a>
        <a href="/about" class="text-link">About the author</a>
      </div>
    </div>
  </div>
</section>

<style>
  .method { display: flex; flex-wrap: wrap; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .method__cover { flex: 0 1 15rem; min-width: 0; max-width: 15rem; }
  .method__text { flex: 1 1 26.25rem; min-width: 0; max-width: 40rem; }
  .method__links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: 1.375rem; }
  .method__links a { color: var(--white); }
</style>
