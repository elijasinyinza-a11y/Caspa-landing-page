---
import { frontmatter as home } from '../../content/home.md';
const { roles } = home;
const groups = [
  { who: 'Executives', text: roles.executive },
  { who: 'Supervisors', text: roles.supervisor },
  { who: 'Staff', text: roles.employee },
];
---
<section class="section section--white" aria-labelledby="roles-h">
  <div class="container">
    <h2 id="roles-h">{roles.heading}</h2>
    <p class="lead">{roles.lead}</p>
    <ul class="roles">
      {groups.map((g) => (
        <li><h3>{g.who}</h3><p>{g.text}</p></li>
      ))}
    </ul>
    <a href="/for-your-role" class="text-link">See what CASPA™ does for your role</a>
  </div>
</section>

<style>
  .roles { list-style: none; margin: 2.25rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 2rem; }
  li { border-top: 2px solid var(--navy); padding-top: 1rem; }
  h3 { font-size: 1.1875rem; }
  p { margin-top: 0.5rem; font-size: 1rem; color: var(--ink-soft); }
  .text-link { margin-top: 1.5rem; }
</style>
