---
import { employeeContract as c, org } from '../../data/sample-utility';
import { components } from '../../data/site';
const pct = Math.round((c.done / c.target) * 100);
---
<div class="phone">
  <div class="phone__screen">
    <div class="screen__title">My contract, {org.year}</div>
    <div class="screen__sub">{c.role}</div>
    <div class="obj">
      <div class="obj__bar" style={`background:${components.performance.color}`}></div>
      <div class="obj__body">
        <div class="obj__text">{c.objective}</div>
        <div class="obj__track" role="img" aria-label={`${pct}% complete`}><div style={`width:${pct}%`}></div></div>
        <div class="obj__progress">{c.done} of {c.target} {c.unit}</div>
      </div>
    </div>
    <div class="trace__title">How this connects</div>
    <ol class="trace">
      {c.trace.map((t, i) => (
        <li class:list={{ 'trace__goal': i === c.trace.length - 1 }}>
          <span class="trace__swatch" style={`background:${components[t.component].color}`} aria-hidden="true"></span>{t.text}
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  .phone { background: var(--navy); border-radius: 34px; padding: 10px; max-width: 18rem; margin-inline: auto; }
  .phone__screen { background: var(--cream); border-radius: 26px; padding: 1.375rem 1rem 1.25rem; }
  .obj { margin-top: 0.875rem; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .obj__bar { height: 4px; }
  .obj__body { padding: 0.75rem; }
  .obj__text { font-size: 0.875rem; font-weight: 600; line-height: 1.35; }
  .obj__track { margin-top: 0.625rem; height: 6px; background: var(--track); border-radius: 3px; }
  .obj__track div { height: 6px; background: var(--navy); border-radius: 3px; }
  .obj__progress { margin-top: 6px; font-size: var(--text-caption); color: var(--muted); }
  .trace__title { margin-top: 1rem; font-size: var(--text-caption); font-weight: 700; }
  .trace { list-style: none; margin: 0.5rem 0 0; padding: 0; font-size: var(--text-caption); }
  .trace li { display: flex; gap: 8px; align-items: center; position: relative; }
  .trace li + li { margin-top: 10px; }
  .trace li + li::before { content: ''; position: absolute; left: 3px; top: -10px; width: 2px; height: 10px; background: var(--rule); }
  .trace__swatch { width: 8px; height: 8px; border-radius: 2px; flex: none; }
  .trace__goal { font-weight: 600; }
</style>
