---
/**
 * The chain from goal to individual action, as a simple diagram.
 * No organisation or figures: it shows the structure, not sample data.
 */
import { components, type ComponentKey } from '../../data/site';
interface Props { caption?: string }
const { caption } = Astro.props;

const steps: { component: ComponentKey; level: string; text: string }[] = [
  { component: 'strategy', level: 'Goal', text: 'A strategic goal in the plan of record' },
  { component: 'cascade', level: 'Objective', text: 'What must change to reach the goal' },
  { component: 'cascade', level: 'KPI', text: 'How progress is measured, with a named owner' },
  { component: 'cascade', level: 'Activity', text: 'The work that moves the KPI' },
  { component: 'plan', level: 'Budget line', text: 'The money that funds the activity' },
  { component: 'performance', level: 'Contract objective', text: "One person's part, in their performance contract" },
];
const last = steps.length - 1;
---
<figure class="los">
  <ol class="los__steps">
    {steps.map((step, i) => (
      <li class:list={['los__step', { 'los__step--you': i === last }]}>
        <div class="los__bar" style={`background:${components[step.component].color}`}></div>
        <div class="los__body">
          <div class="los__label">
            <span class="los__swatch" style={`background:${components[step.component].color}`} aria-hidden="true"></span>
            <strong>{step.level}</strong>
            <span>in {components[step.component].name}</span>
          </div>
          <div class="los__text">{step.text}</div>
        </div>
      </li>
    ))}
  </ol>
  {caption && <figcaption class="caption">{caption}</figcaption>}
</figure>

<style>
  .los { margin: 0; }
  .los__steps { list-style: none; margin: 0; padding: 0; }
  .los__step { background: var(--white); border: 1px solid var(--border); border-radius: 8px; }
  .los__step + .los__step { margin-top: 12px; position: relative; }
  .los__step + .los__step::before {
    content: ''; position: absolute; top: -13px; left: 22px; width: 2px; height: 12px; background: var(--rule);
  }
  .los__step--you { border: 1.5px solid var(--navy); }
  .los__bar { height: 4px; border-radius: 7px 7px 0 0; }
  .los__body { padding: 0.625rem 0.875rem; }
  .los__label { display: flex; align-items: center; gap: 7px; font-size: var(--text-caption); color: var(--muted); }
  .los__label strong { color: var(--navy); font-weight: 600; }
  .los__swatch { width: 9px; height: 9px; border-radius: 2px; flex: none; }
  .los__text { margin-top: 3px; font-size: var(--text-small); font-weight: 600; line-height: 1.35; }
</style>
