---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Placeholder from '../components/Placeholder.astro';
import LineOfSight from '../components/screens/LineOfSight.astro';
import ActivityRecord from '../components/screens/ActivityRecord.astro';
import FindingsDrawer from '../components/screens/FindingsDrawer.astro';
import TwoDoors from '../components/home/TwoDoors.astro';
---
<BaseLayout title="How it works" description="How CASPA™ connects strategic goals to funded, accountable individual action.">
  <PageIntro title="How it works" lead="CASPA™ follows one chain from the strategic goal to one person's objective, and checks that every link holds." />
  <section class="section section--white">
    <div class="container split">
      <div class="split__text">
        <h2>From goal to desk</h2>
        <Placeholder text="[The four components as one journey: Strategy, Cascade, Plan, Performance. Copy for Elijah's review]" />
      </div>
      <div class="split__visual"><LineOfSight caption="Fictional sample data." /></div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>The activity page</h2>
      <p class="lead">Every activity carries its goal, KPI, budget lines and contract objectives on one record.</p>
      <ActivityRecord caption="Illustrative screen, fictional data." />
    </div>
  </section>
  <section class="section section--white">
    <div class="container split">
      <div class="split__text">
        <h2>The integrity checker</h2>
        <p class="lead">Breaks in the chain are flagged while there is still time to fix them.</p>
        <a href="/integrity-checker" class="text-link">More about the integrity checker</a>
      </div>
      <div class="split__visual"><FindingsDrawer caption="Structural examples only, fictional data." /></div>
    </div>
  </section>
  <TwoDoors />
</BaseLayout>

<style>
  .split { display: flex; flex-wrap: wrap; gap: clamp(2rem, 5vw, 4.5rem); align-items: flex-start; }
  .split__text { flex: 1 1 22rem; min-width: 0; max-width: 34rem; }
  .split__visual { flex: 1 1 24rem; min-width: 0; max-width: 32rem; }
</style>
