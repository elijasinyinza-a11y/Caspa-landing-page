---
/**
 * "Request pilot access": the site's one primary action.
 * Frontend only: the form posts to PUBLIC_PILOT_FORM_ENDPOINT (a form service
 * or a separate API). Until that is set, the form shows a "not connected"
 * notice and cannot be submitted.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Placeholder from '../../components/Placeholder.astro';
import { sectors, countries, staffRanges, strategicPlanOptions } from '../../data/pilot-form';

const endpoint = import.meta.env.PUBLIC_PILOT_FORM_ENDPOINT?.trim() || '';
const connected = endpoint.length > 0;
---
<BaseLayout title="Request pilot access" showPilotCta={false} description="Request access to the CASPA™ pilot.">
  <PageIntro title="Request pilot access" lead="Tell us a little about your organisation. We'll use it to prepare a useful first conversation." />
  <section class="section section--white">
    <div class="container layout">
      <form class="form" method="post" action={connected ? endpoint : undefined} data-endpoint={endpoint} novalidate>
        {!connected && (
          <p class="notice" role="status">This form is not connected yet. Set PUBLIC_PILOT_FORM_ENDPOINT before launch.</p>
        )}

        <div class="field">
          <label for="name">Full name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="title">Job title</label>
          <input id="title" name="job_title" type="text" autocomplete="organization-title" required />
        </div>
        <div class="field">
          <label for="org">Organisation</label>
          <input id="org" name="organisation" type="text" autocomplete="organization" required />
        </div>
        <div class="field">
          <label for="sector">Sector</label>
          <select id="sector" name="sector" required>
            <option value="">Choose a sector</option>
            {sectors.map((s) => <option>{s}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="country">Country</label>
          <select id="country" name="country" required>
            <option value="">Choose a country</option>
            {countries.map((c) => <option>{c}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="staff">Number of staff</label>
          <select id="staff" name="staff" required>
            <option value="">Choose a range</option>
            {staffRanges.map((r) => <option>{r}</option>)}
          </select>
        </div>
        <fieldset class="field">
          <legend>Do you have a current strategic plan?</legend>
          <div class="radios">
            {strategicPlanOptions.map((o, i) => (
              <label class="radio"><input type="radio" name="strategic_plan" value={o.value} required={i === 0} /> {o.label}</label>
            ))}
          </div>
        </fieldset>
        <div class="field">
          <label for="fix">What do you most want to fix? <span class="optional">(optional)</span></label>
          <textarea id="fix" name="want_to_fix" rows="3" maxlength="600"></textarea>
        </div>
        <div class="field">
          <label class="check">
            <input type="checkbox" name="consent" value="yes" required />
            <span>I agree to be contacted about the CASPA™ pilot and have read the <a href="/privacy">privacy notice</a>.</span>
          </label>
        </div>

        <p class="error" role="alert" hidden></p>
        <button type="submit" class="btn btn--primary btn--lg" disabled={!connected}>Request pilot access</button>
      </form>

      <aside class="aside">
        <h2 class="h3">What happens next</h2>
        <Placeholder text="[Who answers pilot requests, and within how many working days: OPEN]" />
        <h2 class="h3 aside__h">What joining the pilot involves</h2>
        <Placeholder text="[Length, cost and commitments: to be confirmed]" />
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('.form');
  const error = form?.querySelector<HTMLParagraphElement>('.error');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !error || !button) return;
    error.hidden = true;

    if (!form.checkValidity()) {
      const firstInvalid = form.querySelector<HTMLElement>(':invalid');
      error.textContent = 'Please complete the required fields.';
      error.hidden = false;
      form.reportValidity();
      firstInvalid?.focus();
      return;
    }

    const endpoint = form.dataset.endpoint;
    if (!endpoint) return;

    button.disabled = true;
    button.textContent = 'Sending…';
    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(String(response.status));
      window.location.assign('/request-pilot-access/thank-you');
    } catch {
      error.textContent = "Your request wasn't sent. Check your connection and try again.";
      error.hidden = false;
      button.disabled = false;
      button.textContent = 'Request pilot access';
    }
  });
</script>

<style>
  .layout { display: flex; flex-wrap: wrap; gap: clamp(2rem, 5vw, 4.5rem); align-items: flex-start; }
  .form { flex: 1 1 26rem; min-width: 0; max-width: 40rem; display: grid; gap: 1.25rem; }
  .aside { flex: 1 1 18rem; min-width: 0; max-width: 26rem; }
  .aside__h { margin-top: 2rem; }
  .h3 { font-size: 1.1875rem; }

  .field { display: grid; gap: 0.375rem; border: 0; margin: 0; padding: 0; min-width: 0; }
  label, legend { font-weight: 600; font-size: var(--text-small); padding: 0; }
  .optional { font-weight: 400; color: var(--muted); }
  input[type='text'], input[type='email'], select, textarea {
    font: inherit; color: var(--navy); background: var(--white);
    border: 1.5px solid #8a8578; border-radius: var(--radius-sm);
    min-height: var(--tap); padding: 0.5rem 0.75rem; width: 100%;
  }
  textarea { resize: vertical; }
  .radios { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; margin-top: 0.25rem; }
  .radio, .check { display: flex; align-items: center; gap: 0.5rem; min-height: var(--tap); font-weight: 400; font-size: var(--text-body); }
  .check { align-items: flex-start; padding-top: 0.625rem; }
  .check input { margin-top: 0.3rem; }
  input[type='radio'], input[type='checkbox'] { width: 1.25rem; height: 1.25rem; accent-color: var(--navy); flex: none; }

  .notice { padding: 0.75rem 0.875rem; border: 1px dashed var(--muted); border-radius: var(--radius-sm); color: var(--muted); font-size: var(--text-small); }
  .error { color: var(--block); font-weight: 600; font-size: var(--text-small); }
  button[disabled] { opacity: 0.55; cursor: not-allowed; }
  .form .btn { justify-self: start; }
</style>
